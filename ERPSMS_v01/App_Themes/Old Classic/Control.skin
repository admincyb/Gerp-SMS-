<%--
Default skin template. The following skins are provided as examples only.

1. Named control skin. The SkinId should be uniquely defined because
   duplicate SkinId's per control type are not allowed in the same theme.

<asp:GridView runat="server" SkinId="gridviewSkin" BackColor="White" >
   <AlternatingRowStyle BackColor="Blue" />
</asp:GridView>
 
2. Default skin. The SkinId is not defined. Only one default 
   control skin per control type is allowed in the same theme.

<asp:Image runat="server" ImageUrl="~/images/image1.jpg" />Font-Names="Verdana" GridLines="None" GridLines="Both" Font-Names="Verdana" BorderWidth="1px" BorderStyle="solid" BorderColor="Red"
--%>

<asp:GridView runat="server" CSSclass="gridwrap" CellSpacing="0" CellPadding="0" Height="10px" BorderWidth="1px" BorderStyle="solid" BorderColor="#c6d3e7">
    <HeaderStyle Font-Names="Verdana" ForeColor="#506C92" Font-Size="10px"  HorizontalAlign="left" CssClass="grdhead" Height="25px" />  
    <RowStyle BackColor="#ffffff" Font-Names="Verdana" Font-Size="11px" BorderWidth="1px" Height="10px" BorderStyle="solid" BorderColor="#c6d3e7" ForeColor="#263d62"/>
    <EditRowStyle BackColor="#999999" ForeColor="#333333" /> 
    <SelectedRowStyle Font-Names="Verdana" Font-Size="11px" BackColor="#ecf0f6" Font-Bold="True" ForeColor="#73819d" />
    <AlternatingRowStyle BackColor="#ffffff" BorderWidth="1px" BorderStyle="solid" BorderColor="#c6d3e7" ForeColor="#263d62" />    
    <FooterStyle Font-Names="Verdana" Font-Size="10px" BackColor="#adb5ca" Font-Bold="True" ForeColor="#122648" HorizontalAlign="Left" Height="30px"/> 
    <PagerStyle Font-Names="Verdana" Font-Size="10px" BackColor="#dee3ed" ForeColor="#122648" HorizontalAlign="Center" Height="20px" />
</asp:GridView>

<asp:TextBox runat="server" 
    BorderStyle="solid" BorderColor="#eaf2f5"  Font-Size="12px" Font-Names="Verdana"
    BackColor="White" ForeColor="#1c5180" style="padding:3px 2px;margin:0 3px 10px 0;"><%--height:16px;--%>
</asp:TextBox>

<asp:DropDownList runat="server" 
  Font-Names="Verdana" Font-Bold="False"  BorderWidth="1px" BorderStyle="solid" Font-Size="12px"
  ForeColor="#1c5180"  BackColor="White" style="padding:3px 2px; height:22px; margin:0 3px 10px 0;">
</asp:DropDownList>

<asp:Label runat="server" Font-Names="Verdana" style="height:12px;margin:0 3px 10px 0;">
</asp:Label>

<asp:LinkButton runat="server" Font-Underline="false" Font-Names="Verdana"> 
</asp:LinkButton>

<asp:HyperLink runat="server" Font-Size="11px" Font-Names="Verdana">
</asp:HyperLink> 
 
<asp:Button  runat="server" Font-Names="Verdana" CssClass="ui-button ui-state-default ui-corner-all ui-button-text-only" style="margin-right:3px; height:24px; font-size:11px;"/>

