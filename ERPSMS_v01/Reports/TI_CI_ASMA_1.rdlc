                      <Value>=Code.HTMLDecode(First(Fields!CMP_ADDR1.Value, "CompanyDtls")) &amp;  
IIF(len(First(Fields!CMP_ADDR2.Value, "CompanyDtls"))&gt;0, VBCRLF &amp; Code.HTMLDecode(First(Fields!CMP_ADDR2.Value, "CompanyDtls")),"") &amp; 
iif(Len(First(Fields!CMP_PHONE.Value, "CompanyDtls"))&gt;0, VBCRLF &amp; "Tel : " &amp; First(Fields!CMP_PHONE.Value, "CompanyDtls"),"") &amp; 
iif(Len(First(Fields!CMP_FAX.Value, "CompanyDtls"))&gt;0, "  Fax : " &amp; First(Fields!CMP_FAX.Value, "CompanyDtls"),"") &amp; 
iif(Len(First(Fields!CMP_WEBSITE.Value, "CompanyDtls"))&gt;0,VBCRLF &amp;"Website : " &amp; First(Fields!CMP_WEBSITE.Value, "CompanyDtls"),"") &amp; VBCRLF &amp; "GST No. : " &amp; (First(Fields!ICH_CMP_GST_NO.Value, "DOHeaderDtls"))</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>7pt</FontSize>
