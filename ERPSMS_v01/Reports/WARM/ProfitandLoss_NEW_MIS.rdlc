                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>COA_NAME1</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <BackgroundColor>=IIf(Fields!RTC_LEVEL.Value= 1,"AliceBlue","")</BackgroundColor>
                        <PaddingLeft>=IIf(Fields!RTC_LEVEL.Value &gt;1,CStr(Fields!RTC_LEVEL.Value * 10) &amp; "pt","2pt")</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="RTC_AMOUNT">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(Fields!RTC_IS_TOTAL1.Value = 1,
			iif(Fields!RTC_IS_GROUP.Value = 1,
					IIF(Sum(Fields!RTC_AMOUNT.Value) &lt; 0 ,
							"(" &amp; Format(abs(Sum(Fields!RTC_AMOUNT.Value)),Parameters!CurrencyFormat.Value) &amp; ")" ,	
							 IIF(Sum(Fields!RTC_AMOUNT.Value)=0,
								"",
								Sum(Fields!RTC_AMOUNT.Value))),
					iif(Fields!RTC_AMOUNT.Value&lt;0,
							"("&amp; Format(abs(Fields!RTC_AMOUNT.Value),Parameters!CurrencyFormat.Value) &amp;")",
							IIF(CDbl(Fields!RTC_AMOUNT.Value)=0,
								"",
								CDbl(Fields!RTC_AMOUNT.Value)))),
			IIF(Fields!RTC_LEVEL.Value &gt; 1,
					IIF(Sum(Fields!RTC_AMOUNT.Value) &lt; 0,
							"(" &amp; Format(abs(Sum(Fields!RTC_AMOUNT.Value)),Parameters!CurrencyFormat.Value) &amp; ")",
							IIF(Sum(Fields!RTC_AMOUNT.Value)=0,
								"",
								Sum(Fields!RTC_AMOUNT.Value))),
					IIF((Fields!RTC_AMOUNT.Value) &lt; 0,
							"(" &amp; Format(abs((Fields!RTC_AMOUNT.Value)),Parameters!CurrencyFormat.Value) &amp; ")",
							IIF((Fields!RTC_AMOUNT.Value)=0,
								"",
								(Fields!RTC_AMOUNT.Value))))
)</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>=IIF(Fields!RTC_IS_BOLD.Value = 1 ,"Bold","Default")</FontWeight>
                                <Format>=Parameters!CurrencyFormat.Value</Format>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>RTC_AMOUNT</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <BackgroundColor>=IIf(Fields!RTC_LEVEL.Value = 1,"AliceBlue","")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox13">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(Sum(IIf(Fields!COL_IS_COST_CENTER.Value&lt;&gt;"1", CDbl(Fields!RTC_AMOUNT.Value), CDbl(0))) &lt; 0 ,
			"(" &amp; Format(abs(Sum(IIf(Fields!COL_IS_COST_CENTER.Value&lt;&gt;"1", CDbl(Fields!RTC_AMOUNT.Value), CDbl(0)))),Parameters!CurrencyFormat.Value) &amp; ")",	
			IIF(Sum(IIf(Fields!COL_IS_COST_CENTER.Value&lt;&gt;"1", CDbl(Fields!RTC_AMOUNT.Value), CDbl(0)))=0,
				"",
				Sum(IIf(Fields!COL_IS_COST_CENTER.Value&lt;&gt;"1", CDbl(Fields!RTC_AMOUNT.Value), CDbl(0)))))</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>=IIF(Fields!RTC_IS_BOLD.Value = 1 ,"Bold","Default")</FontWeight>
