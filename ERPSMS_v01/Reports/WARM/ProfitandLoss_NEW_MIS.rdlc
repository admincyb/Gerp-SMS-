                    <Textbox Name="COA_NAME2">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Code.HTMLDecode(Fields!RTC_NAME.Value)</Value>
                              <Style>
                                <FontFamily>Arial Unicode MS</FontFamily>
                                <FontSize>8pt</FontSize>
                                <FontWeight>=IIF(Fields!RTC_IS_BOLD.Value = 1 ,"Bold","Default")</FontWeight>
