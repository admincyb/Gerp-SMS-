            <TablixRow>
              <Height>0.16443in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox40">
                      <CanGrow>true</CanGrow>
                      <CanShrink>true</CanShrink>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>      หากไม่ลงชื่อถือว่าขอนำภาษีที่ชำระเกินเดือนนี้ไปชำระภาษีมูลค่าเพิ่มในเดือน</Value>
