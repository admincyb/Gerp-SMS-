                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox501">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>คำรับรอง</Value>
