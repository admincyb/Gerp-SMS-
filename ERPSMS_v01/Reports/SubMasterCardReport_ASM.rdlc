																First(Fields!ISD_NATURE_CODE_TEXT.Value, "HeaderWeightDS") = "L",
																"Latex" &amp; IIF (First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS")="",""," - " &amp; First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS")),
																First(Fields!ISD_NATURE_CODE_TEXT.Value, "HeaderWeightDS") = "N",
																"Nitrile" &amp; IIF (First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS")="",""," - " &amp; First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS")),
																1=1,
																First(Fields!ISD_NATURE_CODE_TEXT.Value, "HeaderWeightDS") &amp; IIF (First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS")="",""," - " &amp; First(Fields!ISD_SURFACE_TEXT.Value, "HeaderWeightDS"))
																)
															</Value>
