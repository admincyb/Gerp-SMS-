                    <TablixCell>
                      <CellContents>
                        <Textbox Name="FTR_ACCOUNT_CODE">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!FTR_ACCOUNT_CODE.Value</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>FTR_ACCOUNT_CODE</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                              <Width>0.35pt</Width>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="FTR_ACCOUNT_NAME">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Code.HTMLDecode(Fields!FTR_ACCOUNT_NAME.Value) &amp; VBCRLF &amp; IIF(len(Fields!FTR_NARRATION.Value)&gt;0, Code.HTMLDecode(Fields!FTR_NARRATION.Value),"") &amp;
IIF(len(Fields!FTR_INSTR_NO.Value)&gt;0," Cheque No. : " &amp; Code.HtmlDecode(Fields!FTR_INSTR_NO.Value) &amp; " - ","") &amp;
IIF(ISNothing(Fields!FTR_INSTR_DATE.Value),""," Date : " &amp; Format(CDATE(Fields!FTR_INSTR_DATE.Value),Parameters!DateFormat.Value) &amp; "  ")</Value>
                                  <Style>
                                    <FontFamily>Arial Unicode MS</FontFamily>
                                    <FontSize>7pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>FTR_ACCOUNT_NAME</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                              <Width>0.35pt</Width>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox46">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!FTR_EXCHG_RATE.Value&gt;0, Format(Fields!FTR_EXCHG_RATE.Value,Parameters!ExchangeRate.Value),"")</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                  </Style>
