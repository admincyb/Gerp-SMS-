sum(Cdec(Format((Fields!PVM_PAID_AMOUNT_TC.Value + Fields!PVM_DISC_AMOUNT.Value) * Fields!PVM_INV_EXCHG_RATE.Value,Parameters!CurrencyFormat.Value))))
