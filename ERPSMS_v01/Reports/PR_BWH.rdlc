                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ITM_CODE">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!ITM_CODE.Value</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>ITM_CODE</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ITM_NAME">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(ISNothing(Fields!ITM_NAME.Value),"",Fields!ITM_NAME.Value) &amp; 
IIf(Fields!PRD_ITEM_SPEC.Value()&lt;&gt;"","  (Spec: " &amp; Fields!PRD_ITEM_SPEC.Value &amp; ")","") &amp;
Switch(len(Fields!ITEM_PAPER_COLOUR.Value) OR len(Fields!ITEM_PLY.Value) &gt;0, VBCRLF &amp; "Quality : "  &amp; Code.HtmlDecode(Fields!ITEM_PLY.Value) &amp; " " &amp; Code.HtmlDecode(Fields!ITEM_PAPER_COLOUR.Value)) &amp;
Switch(len(Fields!ITEM_PAPER_TYPE.Value)&gt;0, " - " &amp; Code.HtmlDecode(Fields!ITEM_PAPER_TYPE.Value)) &amp;
Switch(len(Fields!ITEM_THICKNESS.Value)&gt; 0, " - Thickness : " &amp; Code.HtmlDecode(Fields!ITEM_THICKNESS.Value))






'=IIF(ISNothing(Fields!ITM_NAME.Value),"",Fields!ITM_NAME.Value) &amp; 
'IIf(Fields!PRD_ITEM_SPEC.Value.ToString()&lt;&gt;"","  (Spec: " &amp; Fields!PRD_ITEM_SPEC.Value &amp; ")","") &amp;
'Switch(len(Fields!ITEM_PAPER_COLOUR.Value) OR len(Fields!ITEM_PLY.Value) &gt;0, VBCRLF &amp; "Quality : "  &amp; Code.HtmlDecode(Fields!ITEM_PLY.Value) &amp; " " &amp; Code.HtmlDecode(Fields!ITEM_PAPER_COLOUR.Value)) &amp;
'Switch(len(Fields!ITEM_PAPER_TYPE.Value)&gt;0, " - " &amp; Code.HtmlDecode(Fields!ITEM_PAPER_TYPE.Value)) &amp;
'Switch(len(Fields!ITEM_THICKNESS.Value)&gt; 0, " - Thickness : " &amp; Code.HtmlDecode(Fields!ITEM_THICKNESS.Value))</Value>
                              <Style>
                                <FontFamily>Arial Unicode MS</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>ITM_NAME</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
