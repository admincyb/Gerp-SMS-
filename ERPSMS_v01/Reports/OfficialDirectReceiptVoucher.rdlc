                    <TextRun>
                      <Value>=Code.HTMLDecode(First(Fields!CMP_ADDR1.Value, "CompanyDtls")) &amp; " " &amp; 
Code.HTMLDecode(First(Fields!CMP_ADDR2.Value, "CompanyDtls")) &amp; VBCRLF &amp;
iif(Len(First(Fields!CMP_PHONE.Value, "CompanyDtls"))&gt;0,"Tel : " &amp; Code.HTMLDecode(First(Fields!CMP_PHONE.Value, "CompanyDtls")),"") &amp; 
iif(Len(First(Fields!CMP_FAX.Value, "CompanyDtls"))&gt;0, "  Fax : " &amp; Code.HTMLDecode(First(Fields!CMP_FAX.Value, "CompanyDtls")),"") &amp; VBCRLF &amp; 
IIF(Len(First(Fields!CMP_TAX_NO.Value, "CompanyDtls"))&gt;0, "Tax ID: " &amp; Code.HTMLDecode(First(Fields!CMP_TAX_NO.Value, "CompanyDtls")),"")</Value>
