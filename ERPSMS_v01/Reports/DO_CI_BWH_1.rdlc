																IIF(Fields!CID_SALE_UOM_CONV.Value&lt;&gt;1, VBCRLF &amp; "[" &amp; format(Fields!DPD_QTY_ORDERED.Value,"##,#0.##") &amp; " " &amp; Fields!DPD_UOM_TEXT.Value &amp; "]","")
															</Value>
