&amp; IIF(len(Code.HTMLDecode(Fields!CIM_BRAND_CODE.Value))&gt;0,VBCRLF &amp; "Brand Code : " &amp; Code.HTMLDecode(Fields!CIM_BRAND_CODE.Value),"")</Value>
