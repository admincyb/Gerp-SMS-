iif(Len(First(Fields!CMP_GST_NO.Value, "CompanyDtls"))&gt;0,"&lt;br&gt;"  &amp;"  GSTIN/UIN : " &amp; First(Fields!CMP_GST_NO.Value, "CompanyDtls"),"")
'Code.HTMLDecode("&lt;b&gt;" &amp; First(Fields!CMP_NAME.Value, "CompanyDtls") &amp; "&lt;/b&gt;") &amp; "&lt;br&gt;" &amp;</Value>
                      <MarkupType>HTML</MarkupType>
