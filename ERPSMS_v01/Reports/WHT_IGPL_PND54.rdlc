            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>คำรับรองของผู้จ่ายเงินได้ตามมาตรา 70 หรือกรรมการหรือ ผู้เป็นหุ้นส่วน หรือผู้จัดการของบริษัท หรือห้างหุ้นส่งนิติบุคคลที่จ่ายเงินได้หรือจำหน่ายเงินกำไร</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Arial Unicode MS</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
