                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!ADJ_AMOUNT_CN.Value is nothing OR Trim(Fields!ADJ_AMOUNT_CN.Value)="" OR Fields!ADJ_AMOUNT_CN.Value=0 ,"",Fields!ADJ_AMOUNT_CN.Value)</Value>
