                      <CellContents>
                        <Textbox Name="Textbox23">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!INV_TYPE.Value = 1,
IIF(
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value)&gt;0,
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value),
0),
IIF(
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ICH_AMOUNT_ADV_DED_TC.Value - Fields!ADJ_AMOUNT_CN.Value)&gt;0,
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ICH_AMOUNT_ADV_DED_TC.Value - Fields!ADJ_AMOUNT_CN.Value),
0))</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>=Parameters!CurrencyFormat.Value</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
