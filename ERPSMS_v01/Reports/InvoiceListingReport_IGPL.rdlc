                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!INV_TYPE.Value = 1,
Fields!RECEIVED_AMOUNT.Value,
Fields!RECEIVED_AMOUNT.Value + Fields!ICH_AMOUNT_ADV_DED_TC.Value)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>=Parameters!CurrencyFormat.Value</Format>
                                  </Style>
                                </TextRun>
