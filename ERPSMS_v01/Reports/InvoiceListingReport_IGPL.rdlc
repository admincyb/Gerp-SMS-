			(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ICH_AMOUNT_ADV_DED_TC.Value - Fields!ADJ_AMOUNT_CN.Value)*Fields!EXCHG_RATE.Value &gt; 0, 
				(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ICH_AMOUNT_ADV_DED_TC.Value - Fields!ADJ_AMOUNT_CN.Value)*Fields!EXCHG_RATE.Value,
				CDBL(0)
			)
		)
)</Value>
