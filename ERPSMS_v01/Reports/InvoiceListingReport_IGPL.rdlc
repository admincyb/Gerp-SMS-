                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(
	IIf(
		Fields!INV_TYPE.Value=1,
			IIF(
				(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value)&gt;0,
				(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value),
				CDBL(0)),
			CDBL(0)
		) +

	IIf(
		Fields!INV_TYPE.Value&lt;&gt;1,
			IIF(
				(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ICH_AMOUNT_ADV_DED_TC.Value - Fields!ADJ_AMOUNT_CN.Value)*Fields!EXCHG_RATE.Value &gt; 0, 
