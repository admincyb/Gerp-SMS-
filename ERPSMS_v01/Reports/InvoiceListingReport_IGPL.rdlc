                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!INV_TYPE.Value=1,"",Fields!EXCHG_RATE.Value)</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>=Parameters!ExchangeRate.Value</Format>
