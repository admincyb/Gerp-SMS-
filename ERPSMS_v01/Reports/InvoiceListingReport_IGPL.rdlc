Sum(IIF(
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value)&gt;0,
(Fields!INV_AMOUNT.Value + Fields!ADJ_AMOUNT_DN.Value - Fields!RECEIVED_AMOUNT.Value - Fields!ADJ_AMOUNT_CN.Value),
CDEC(0))),"")</Value>
                                  <Style>
                                    <FontFamily>Verdana</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
