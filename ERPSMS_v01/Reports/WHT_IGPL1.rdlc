                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>           (2.1) Net profit of business that is exempted from income tax.</Value>
                              <Style>
                                <FontStyle>Normal</FontStyle>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>7pt</FontSize>
                                <FontWeight>Normal</FontWeight>
