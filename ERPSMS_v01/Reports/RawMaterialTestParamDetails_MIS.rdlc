                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox5">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Switch(    
		string.IsNullOrEmpty(Fields!TGT_MIN_VAL.Value), (IIF(string.IsNullOrEmpty(Fields!TGT_MAX_VAL.Value),"","&lt;= " &amp; Max(Fields!TGT_MAX_VAL.Value) &amp; " " &amp; Fields!TIP_UOM_TEXT.Value)),
		string.IsNullOrEmpty(Fields!TGT_MAX_VAL.Value), (IIF(string.IsNullOrEmpty(Fields!TGT_MIN_VAL.Value),"","&gt;= " &amp; Min(Fields!TGT_MIN_VAL.Value) &amp; " " &amp; Fields!TIP_UOM_TEXT.Value)),
		Fields!TGT_MIN_VAL.Value = Fields!TGT_MAX_VAL.Value,( Max(Fields!TGT_MAX_VAL.Value)) &amp; " " &amp; Fields!TIP_UOM_TEXT.Value,
		1=1, (Min(Fields!TGT_MIN_VAL.Value) &amp;" - "&amp;Max(Fields!TGT_MAX_VAL.Value)) &amp; " " &amp; Fields!TIP_UOM_TEXT.Value
		)</Value>
                              <Style>
                                <FontFamily>Verdana</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Center</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox5</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
                    <rd:Selected>true</rd:Selected>
