                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox104</rd:DefaultName>
                      <Style>
                        <Border>
                          <Color>LightGrey</Color>
                          <Style>Solid</Style>
                        </Border>
                        <BackgroundColor>=iif(Fields!WEIGHTAGE_ABOVE.Value Is Nothing,Nothing,iif(iif(Fields!COST.Value&gt;0,FormatNumber(Fields!COST.Value/Fields!TOTAL_COST.Value,2),"0.00")&gt;=FormatNumber(Fields!WEIGHTAGE_ABOVE.Value,2),"Silver",Nothing))</BackgroundColor>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop>
                        <PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox>
