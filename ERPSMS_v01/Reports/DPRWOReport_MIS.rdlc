                            <TextRun>
                              <Value>=IIF(Fields!RAH_GRAND_TOTAL.Value=0,0,(IIF(Fields!IS_LAKHS.Value=1, Sum(Fields!RAH_QTY.Value * ((Fields!RAH_COST.Value * Fields!WOH_LUMP_SUM_VALUE.Value)/ Fields!RAH_GRAND_TOTAL.Value))/100000 , Sum(Fields!RAH_QTY.Value * ((Fields!RAH_COST.Value * Fields!WOH_LUMP_SUM_VALUE.Value)/ Fields!RAH_GRAND_TOTAL.Value)))))</Value>
