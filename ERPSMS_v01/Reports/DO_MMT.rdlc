IIF(String.IsNullOrEmpty(Fields!LOT_SIZE.Value),"","     LOT SIZE. " &amp; Code.HTMLDecode(Fields!LOT_SIZE.Value)) &amp;
IIF(len(Fields!CIM_BRAND_CODE.Value)&gt;0, "      Brand Code : " &amp; Code.HTMLDecode(Fields!CIM_BRAND_CODE.Value),"")</Value>
                                  <Style>
                                    <FontFamily>Arial Unicode MS</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox8</rd:DefaultName>
                          <Style>
