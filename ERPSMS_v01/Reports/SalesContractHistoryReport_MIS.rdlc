IIF(Fields!SOH_TYPE.Value = 1,(Fields!SC_INV_AMT.Value + Fields!SC_ADV_INV_AMT.Value),Fields!SC_INV_NET_VALUE.Value)&lt;0,"0.00",Fields!SOH_NET_AMOUNT.Value - 
