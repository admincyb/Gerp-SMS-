'=Fields!SOH_NET_AMOUNT.Value - 
'IIF(Fields!SOH_TYPE.Value = 1,(Fields!SC_INV_AMT.Value + Fields!SC_ADV_INV_AMT.Value),Fields!SC_INV_NET_VALUE.Value)

'Fields!SOH_NET_AMOUNT.Value - (Fields!SC_INV_AMT.Value + Fields!SC_ADV_INV_AMT.Value)</Value>
                              <Style>
