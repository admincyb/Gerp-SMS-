 (IIF(Fields!SOH_TYPE.Value = 1, (Fields!SC_INV_REC_AMT.Value + Fields!SC_ADV_INV_REC_AMT.Value),Fields!SC_INV_REC_AMT.Value) + Fields!SC_INV_CN_AMT.Value)</Value>
