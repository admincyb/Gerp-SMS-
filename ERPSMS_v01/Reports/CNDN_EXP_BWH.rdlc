                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch
(
First(Fields!CRDR_TRX_TYPE.Value, "CrDrHeader") = "VEN",
IIF(IsNothing(Fields!IVH_VENDOR_INV_NO.Value),"","VEN.INV.NO - " &amp; Code.HTMLDecode(Fields!IVH_VENDOR_INV_NO.Value) ) &amp;
IIF(IsNothing(Fields!IVH_VENDOR_INV_DATE.Value),"","  DATE - " &amp; Fields!IVH_VENDOR_INV_DATE.Value) &amp; VBCRLF &amp;
IIF(string.IsNullOrWhiteSpace(Fields!CDH_REF_NO.Value),"", "REF.NO - " &amp; Code.HTMLDecode(Fields!CDH_REF_NO.Value)) &amp;
IIF(IsNothing(Fields!CDH_REF_DATE.Value),"","  DATE - " &amp; Format(CDATE(Fields!CDH_REF_DATE.Value),Parameters!DateFormat.Value))
,
First(Fields!CRDR_TRX_TYPE.Value, "CrDrHeader") = "CUS",
IIF(IsNothing(Fields!INV_NO.Value),"","INV.NO - " &amp; Fields!INV_NO.Value ) &amp;
IIF(IsNothing(Fields!INV_DATE.Value),"","  DATE - " &amp; Fields!INV_DATE.Value) &amp; VBCRLF &amp;
IIF(string.IsNullOrWhiteSpace(Fields!CDH_REF_NO.Value),"", "REF.NO - " &amp; Code.HTMLDecode(Fields!CDH_REF_NO.Value)) &amp;
IIF(IsNothing(Fields!CDH_REF_DATE.Value),"","  DATE - " &amp; Format(CDATE(Fields!CDH_REF_DATE.Value),Parameters!DateFormat.Value))
)</Value>
                                  <Style>
