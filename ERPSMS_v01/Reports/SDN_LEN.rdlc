                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(First(Fields!CRDR_TRX_TYPE.Value, "CrDrHeader") = "CUS",
	Switch(First(Fields!CDH_TYPE.Value, "CrDrHeader") =1,
		Format(
			First(Fields!INV_AMOUNT.Value, "CrDrHeader") +
			(First(Fields!CDH_AMOUNT.Value, "CrDrHeader") - First(Fields!CDH_TAX_AMOUNT.Value, "CrDrHeader")),
		Parameters!CurrencyFormat.Value),
       First(Fields!CDH_TYPE.Value, "CrDrHeader") = 2 ,
		Format(
			First(Fields!INV_AMOUNT.Value, "CrDrHeader") -
			(First(Fields!CDH_AMOUNT.Value, "CrDrHeader") - First(Fields!CDH_TAX_AMOUNT.Value, "CrDrHeader")),
		Parameters!CurrencyFormat.Value)
	 ),
	Switch(First(Fields!CDH_TYPE.Value, "CrDrHeader") =1,
		Format(
			First(Fields!INV_AMOUNT.Value, "CrDrHeader") -
			(First(Fields!CDH_AMOUNT.Value, "CrDrHeader") - First(Fields!CDH_TAX_AMOUNT.Value, "CrDrHeader")),
		Parameters!CurrencyFormat.Value),
       First(Fields!CDH_TYPE.Value, "CrDrHeader") = 2 ,
		Format(
			First(Fields!INV_AMOUNT.Value, "CrDrHeader") +
			(First(Fields!CDH_AMOUNT.Value, "CrDrHeader") - First(Fields!CDH_TAX_AMOUNT.Value, "CrDrHeader")),
		Parameters!CurrencyFormat.Value)
	 )
	)</Value>
