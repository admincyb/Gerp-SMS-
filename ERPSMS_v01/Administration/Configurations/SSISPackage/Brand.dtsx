<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{BA64BE05-F610-430F-B906-483FA4481A69}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="SELECT	COUNT(1)&#xA;FROM	Z_PM_INV_ITEM_MST&#xA;	INNER JOIN	ADM_CONST_MST	PMT	ON	PMT.CON_PK	=	IPD_TYPE&#xA;	LEFT OUTER JOIN PUR_VENDOR_MST	ON	VEN_CODE	=	RTRIM(LTRIM(IPD_VEN_CODE))&#xA;WHERE	VEN_PK	IS NULL&#xA;	AND	ISNULL(IPD_VEN_CODE,'') &lt;&gt; ''" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"><SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::V_MISSING_VEN"/></SQLTask:SqlTaskData></DTS:ObjectData></DTS:Executable>
