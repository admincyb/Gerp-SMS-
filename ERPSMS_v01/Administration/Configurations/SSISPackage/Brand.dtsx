<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{BA64BE05-F610-430F-B906-483FA4481A69}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="	IF EXISTS	(	SELECT	1&#xA;					FROM	SYSOBJECTS&#xA;					WHERE	NAME	=	'Z_BWH_BRANDS_VW')&#xA;	BEGIN&#xA;		DROP VIEW Z_BWH_BRANDS_VW&#xA;	END&#xA;	&#xA;	GO&#xA;	&#xA;	CREATE VIEW	Z_BWH_BRANDS_VW&#xA;	AS&#xA;	SELECT	Z_BWH_BRANDS.*&#xA;			,WLT.CON_PK			AS	WLT_CON_PK&#xA;			,WLT.CON_GROUP		AS	WLT_CON_GROUP&#xA;			,WLT.CON_NAME		AS	WLT_CON_NAME&#xA;			,WLT.CON_VALUE		AS	WLT_CON_VALUE&#xA;			,WLT.CON_DATA		AS	WLT_CON_DATA&#xA;			,WLT.CON_CODE		AS	WLT_CON_CODE&#xA;			,WLT.CON_SPL_COND	AS	WLT_CON_SPL_COND&#xA;			&#xA;			,PC.CON_PK			AS	PC_CON_PK			&#xA;			,PC.CON_GROUP		AS	PC_CON_GROUP		&#xA;			,PC.CON_NAME		AS	PC_CON_NAME		&#xA;			,PC.CON_VALUE		AS	PC_CON_VALUE		&#xA;			,PC.CON_DATA		AS	PC_CON_DATA		&#xA;			,PC.CON_CODE		AS	PC_CON_CODE		&#xA;			,PC.CON_SPL_COND	AS	PC_CON_SPL_COND	&#xA;									&#xA;			,IB.CON_PK			AS	IB_CON_PK			&#xA;			,IB.CON_GROUP		AS	IB_CON_GROUP		&#xA;			,IB.CON_NAME		AS	IB_CON_NAME		&#xA;			,IB.CON_VALUE		AS	IB_CON_VALUE		&#xA;			,IB.CON_DATA		AS	IB_CON_DATA		&#xA;			,IB.CON_CODE		AS	IB_CON_CODE		&#xA;			,IB.CON_SPL_COND	AS	IB_CON_SPL_COND	&#xA;									&#xA;			,POB.CON_PK			AS	POB_CON_PK			&#xA;			,POB.CON_GROUP		AS	POB_CON_GROUP		&#xA;			,POB.CON_NAME		AS	POB_CON_NAME		&#xA;			,POB.CON_VALUE		AS	POB_CON_VALUE		&#xA;			,POB.CON_DATA		AS	POB_CON_DATA		&#xA;			,POB.CON_CODE		AS	POB_CON_CODE		&#xA;			,POB.CON_SPL_COND	AS	POB_CON_SPL_COND	&#xA;									&#xA;			,PRB.CON_PK			AS	PRB_CON_PK			&#xA;			,PRB.CON_GROUP		AS	PRB_CON_GROUP		&#xA;			,PRB.CON_NAME		AS	PRB_CON_NAME		&#xA;			,PRB.CON_VALUE		AS	PRB_CON_VALUE		&#xA;			,PRB.CON_DATA		AS	PRB_CON_DATA		&#xA;			,PRB.CON_CODE		AS	PRB_CON_CODE		&#xA;			,PRB.CON_SPL_COND	AS	PRB_CON_SPL_COND	&#xA;									&#xA;			,ZB.CON_PK			AS	ZB_CON_PK			&#xA;			,ZB.CON_GROUP		AS	ZB_CON_GROUP		&#xA;			,ZB.CON_NAME		AS	ZB_CON_NAME		&#xA;			,ZB.CON_VALUE		AS	ZB_CON_VALUE		&#xA;			,ZB.CON_DATA		AS	ZB_CON_DATA		&#xA;			,ZB.CON_CODE		AS	ZB_CON_CODE		&#xA;			,ZB.CON_SPL_COND	AS	ZB_CON_SPL_COND	&#xA;									&#xA;			,MC.CON_PK			AS	MC_CON_PK			&#xA;			,MC.CON_GROUP		AS	MC_CON_GROUP		&#xA;			,MC.CON_NAME		AS	MC_CON_NAME		&#xA;			,MC.CON_VALUE		AS	MC_CON_VALUE		&#xA;			,MC.CON_DATA		AS	MC_CON_DATA		&#xA;			,MC.CON_CODE		AS	MC_CON_CODE		&#xA;			,MC.CON_SPL_COND	AS	MC_CON_SPL_COND	&#xA;			&#xA;			,APS_PK				AS	PM_APS_PK&#xA;			,APS_CODE			AS	PM_APS_CODE&#xA;			,APS_NAME			AS	PM_APS_NAME&#xA;			,APS_TYPE			AS	PM_APS_TYPE&#xA;			,APS_TOTAL_PCS		AS	PM_APS_TOTAL_PCS&#xA;			--,STUFF(  ISNULL(' - '+WLT.CON_NAME,'') + ISNULL(' - '+PC.CON_NAME,'') + ISNULL(' - '+IB.CON_NAME,'') +&#xA;			--			ISNULL(' - '+POB.CON_NAME,'') + ISNULL(' - '+PRB.CON_NAME,'') + ISNULL(' - '+ZB.CON_NAME,'') +&#xA;			--			ISNULL(' - '+MC.CON_NAME,'') ,1,3,'') + ' ('+&#xA;			--	STUFF(  ISNULL(' x '+CAST(WL_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(PC_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(IB_QTY AS NVARCHAR(10)),'') +&#xA;			--			ISNULL(' x '+CAST(OP_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(OR_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(ZB_QTY AS NVARCHAR(10)),'') +&#xA;			--			ISNULL(' x '+CAST(MC_QTY AS NVARCHAR(10)),'') ,1,3,'') + ')'&#xA;			--			AS TMP_PACK_NAME&#xA;			,(	SELECT	MAX([PIM_PK])&#xA;				FROM	[ADM_PACK_CUST_ITEM_MAP]&#xA;					INNER JOIN	[CRM_CUSTOMER_MST]	ON	[CUS_PK]	=	[PIM_CUSTOMER]&#xA;													AND	[CUS_CODE]	=	CUSCODE&#xA;					INNER JOIN	[CRM_CUST_ITEM_MAP] ON	[CIM_PK]	=	[PIM_CUST_ITEM]&#xA;													AND	[CIM_BRAND_NAME]	=	BRANDNAME&#xA;													AND	ISNULL(CIM_BRAND_CODE,'')	=	ISNULL(BRANDCODE,'')&#xA;				WHERE	[PIM_PACK_SPEC]	=	[APS_PK]&#xA;					AND	[PIM_ACTIVE]	=	1	)	AS	PM_PIM_PK&#xA;	FROM	Z_BWH_BRANDS&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	WLT	ON	WLT.CON_GROUP = 83 AND	WLT.CON_DATA = 'WLT' AND	WL_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	PC	ON	PC.CON_GROUP = 83 AND	PC.CON_DATA = 'PC' AND		PC_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	IB	ON	IB.CON_GROUP = 83 AND	IB.CON_DATA = 'IB' AND		IB_QTY &gt;	0&#xA;		--LEFT OUTER JOIN	ADM_CONST_MST	IC	ON	IC.CON_GROUP = 83 AND	IC.CON_DATA = 'IC' AND		WL_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	POB	ON	POB.CON_GROUP = 83 AND	POB.CON_DATA = 'POB' AND	OP_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	PRB	ON	PRB.CON_GROUP = 83 AND	PRB.CON_DATA = 'PRB' AND	OR_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	ZB	ON	ZB.CON_GROUP = 83 AND	ZB.CON_DATA = 'ZB' AND		ZB_QTY &gt;	0&#xA;		LEFT OUTER JOIN	ADM_CONST_MST	MC	ON	MC.CON_GROUP = 83 AND	MC.CON_DATA = 'MC' AND		MC_QTY &gt;	0&#xA;		LEFT OUTER JOIN ADM_PACK_SPEC_MST	ON	APS_NAME	=	&#xA;				STUFF(  ISNULL(' - '+WLT.CON_NAME,'') + ISNULL(' - '+PC.CON_NAME,'') + ISNULL(' - '+IB.CON_NAME,'') +&#xA;						ISNULL(' - '+POB.CON_NAME,'') + ISNULL(' - '+PRB.CON_NAME,'') + ISNULL(' - '+ZB.CON_NAME,'') +&#xA;						ISNULL(' - '+MC.CON_NAME,'') ,1,3,'') + ' ('+&#xA;				STUFF(  ISNULL(' x '+CAST(WL_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(PC_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(IB_QTY AS NVARCHAR(10)),'') +&#xA;						ISNULL(' x '+CAST(OP_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(OR_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(ZB_QTY AS NVARCHAR(10)),'') +&#xA;						ISNULL(' x '+CAST(MC_QTY AS NVARCHAR(10)),'') ,1,3,'') + ') -' +CAST(CARTON AS NVARCHAR(10))&#xA;			OR	APS_CODE	=	'P'+CAST(CARTON AS NVARCHAR(10))+ ' : ' +&#xA;				STUFF(  ISNULL(' - '+WLT.CON_CODE,'') + ISNULL(' - '+PC.CON_CODE,'') + ISNULL(' - '+IB.CON_CODE,'') +&#xA;						ISNULL(' - '+POB.CON_CODE,'') + ISNULL(' - '+PRB.CON_CODE,'') + ISNULL(' - '+ZB.CON_CODE,'') +&#xA;						ISNULL(' - '+MC.CON_CODE,'') ,1,3,'') + ' ('+&#xA;				STUFF(  ISNULL(' x '+CAST(WL_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(PC_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(IB_QTY AS NVARCHAR(10)),'') +&#xA;						ISNULL(' x '+CAST(OP_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(OR_QTY AS NVARCHAR(10)),'') + ISNULL(' x '+CAST(ZB_QTY AS NVARCHAR(10)),'') +&#xA;						ISNULL(' x '+CAST(MC_QTY AS NVARCHAR(10)),'') ,1,3,'') + ')'&#xA;&#xA;	GO&#xA;	--SELECT * FROM Z_BWH_BRANDS_VW" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
