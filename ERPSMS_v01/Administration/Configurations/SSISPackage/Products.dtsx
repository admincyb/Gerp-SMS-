<DTS:Property DTS:Name="CreationName">Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91</DTS:Property>
<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{4DDFBD61-6F2A-412F-89E4-12F344D6F437}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="BEGIN TRY&#xA; BEGIN TRAN&#xA;   IF NOT EXISTS(SELECT 1 FROM sys.objects WHERE name like 'TEMP_OUTPUT')&#xA;    BEGIN&#xA;     CREATE TABLE [dbo].[TEMP_OUTPUT](&#xA;      [ROWNO] [int] NULL,&#xA;      [CUSCODE] [nvarchar](100) NULL,&#xA;      [BRANDCODE] [nvarchar](100) NULL,&#xA;      [BRANDNAME] [nvarchar](200) NULL,&#xA;      [PRDCODE] [nvarchar](100) NULL&#xA;     ) ON [PRIMARY]&#xA;    END&#xA;   ELSE &#xA; &#xA;     TRUNCATE TABLE [TEMP_OUTPUT]&#xA; &#xA;    &#xA;   --update brand name with the change&#xA;   UPDATE Z_BWH_BRANDS&#xA;   SET  BRANDNAME = LTRIM(BRANDNAME + ISNULL(' ('+ CAST(SUBSTRING(PRDCODE,12,3) AS NVARCHAR(10)) +')',''))&#xA; COMMIT&#xA; --ROLLBACK&#xA;END TRY&#xA;BEGIN CATCH&#xA;  SELECT ERROR_MESSAGE()&#xA;  ROLLBACK&#xA;END CATCH &#xA;" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
