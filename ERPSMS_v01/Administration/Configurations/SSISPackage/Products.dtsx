<DTS:Property DTS:Name="ObjectName">INS_ITM_SPEC_GRADE1</DTS:Property>
<DTS:Property DTS:Name="DTSID">{0EFCB902-FCBB-48F8-8550-DDE3206D0070}</DTS:Property>
<DTS:Property DTS:Name="Description">Execute SQL Task</DTS:Property>
<DTS:Property DTS:Name="CreationName">Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91</DTS:Property>
<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{4DDFBD61-6F2A-412F-89E4-12F344D6F437}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="BEGIN TRY&#xA;	BEGIN TRAN&#xA;	&#xA;	DECLARE  @V_ITM_PK	INT&#xA;			,@V_ISD_PK	INT&#xA;	SELECT	@V_ITM_PK	=	ISNULL(MAX(ITM_PK),0) FROM INV_ITEM_MST &#xA;	SELECT	@V_ISD_PK	=	ISNULL(MAX(ISD_PK),0) FROM INV_ITEM_SPEC_DTL &#xA;	--DELETE FROM Z_BWH_PRODUCTS WHERE UPDATEDCODE = ''&#xA;	INSERT INTO INV_ITEM_MST&#xA;	(&#xA;		ITM_PK&#xA;		,ITM_CODE&#xA;		,ITM_NAME&#xA;		,ITM_DESC&#xA;		,ITM_CATEGORY&#xA;		,ITM_TYPE&#xA;		,ITM_GROUP&#xA;		,ITM_WEIGHT&#xA;		,ITM_MIN_WEIGHT&#xA;		,ITM_MAX_WEIGHT&#xA;		,ITM_UOM&#xA;		,ITM_MIN_STK&#xA;		,ITM_ROL_STK&#xA;		,ITM_MAX_STK&#xA;		,ITM_MOQ&#xA;		,ITM_ACTIVE&#xA;		,ITM_BIZUNIT&#xA;		,ITM_CRTD_BY&#xA;		,ITM_CRTD_DT&#xA;		,ITM_MOD_BY&#xA;		,ITM_MOD_DT&#xA;		,ITM_REF1&#xA;		,ITM_REF2&#xA;		,ITM_REF3	&#xA;		,ITM_REF4	&#xA;	)&#xA;	SELECT	 @V_ITM_PK + ROW_NUMBER() OVER(ORDER BY [UPDATEDNAME])	&#xA;			,[UPDATEDCODE]						--CODE							&#xA;			,[UPDATEDNAME]						--NAME								&#xA;			,[UPDATEDNAME]						--DESC								&#xA;			,2									--CATEGORY							&#xA;			,1									--TYPE								&#xA;			,NULL								--GROUP								&#xA;			,ISNULL(AVG_WT,0)					--WEIGHT							&#xA;			,ISNULL(MIN_WT,0)					--MIN WEIGHT						&#xA;			,ISNULL(MAX_WT,0)					--MAX WEIGHT						&#xA;			,ISNULL((SELECT UOM_PK&#xA;			  FROM INV_UOM_MST&#xA;			  WHERE [UOM_CODE] = [UNIT]),80)	--UOM								&#xA;			,0									--MIN STK							&#xA;			,0									--ROL STK							&#xA;			,0									--MAX STK							&#xA;			,NULL																&#xA;			,1									--ACTIVE							&#xA;			,1									--BIZUNIT							&#xA;			,1									--CRTD BY							&#xA;			,GETDATE()															&#xA;			,1									--MOD BY							&#xA;			,GETDATE()																																				&#xA;			,[510K]												&#xA;			,[MDL]&#xA;			,[PROD_SPEC]&#xA;			,[OLDCODE]&#xA;	FROM&#xA;	(&#xA;	SELECT *&#xA;			,ROW_NUMBER()OVER(PARTITION BY [UPDATEDCODE] ORDER BY UPDATEDNAME)  as row&#xA;	FROM [Z_BWH_PRODUCTS] &#xA;&#xA;	)tab&#xA;	where row=1	&#xA;		AND [UPDATEDCODE]	NOT IN (SELECT ITM_CODE FROM INV_ITEM_MST)	&#xA;															&#xA;	-- item specification into spec dtls&#xA;	INSERT INTO INV_ITEM_SPEC_DTL&#xA;	(&#xA;		 [ISD_PK]&#xA;		,[ISD_ITEM]&#xA;		,[ISD_NATURE]&#xA;		,[ISD_THICKNESS]&#xA;		,[ISD_PROCESS]&#xA;		,[ISD_SURFACE]&#xA;		,[ISD_COLOUR]&#xA;		,[ISD_GRADE]&#xA;		,[ISD_SIZE]&#xA;		,[ISD_LENGTH]&#xA;		,[ISD_CHLORINATION]&#xA;		,[ISD_STERILE]&#xA;		,[ISD_CLEAN_ROOM]&#xA;		,[ISD_ADNL_SPEC01]&#xA;		,[ISD_ADNL_SPEC02]&#xA;		,[ISD_ADNL_SPEC03]&#xA;		,[ISD_ADNL_SPEC04]&#xA;		,[ISD_ADNL_SPEC05]&#xA;		,[ISD_ADNL_SPEC06]&#xA;		,[ISD_ADNL_SPEC07]&#xA;		,[ISD_ADNL_SPEC08]&#xA;		,[ISD_ADNL_SPEC09]&#xA;		,[ISD_REMARKS]&#xA;		,[ISD_ACTIVE]&#xA;		,[ISD_MOD_BY]&#xA;		,[ISD_MOD_DT]&#xA;	)&#xA;	SELECT	 @V_ISD_PK + ROW_NUMBER() OVER(ORDER BY [UPDATEDNAME])		--PK&#xA;			,@V_ITM_PK + ROW_NUMBER() OVER(ORDER BY [UPDATEDNAME])		--ITEM&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 42 AND CON_CODE = [X1])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 43 AND CON_CODE = [X16])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 44 AND CON_CODE = [X3])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 45 AND CON_CODE = [X4])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 46 AND CON_CODE = [X6])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 47 AND CON_CODE = [X15])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 48 AND (CON_CODE = [X7] /*OR CON_VALUE = [SIZE]*/))&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 49 AND CON_CODE = [X5])&#xA;			,NULL&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 51 AND CON_CODE = [X8])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 52 AND CON_CODE = [X9])&#xA;			,NULL&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 54 AND CON_CODE = [X2])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 55 AND CON_CODE = [X10])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 56 AND CON_CODE = [X11])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 57 AND CON_CODE = [X12])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 58 AND CON_CODE = [X13])&#xA;			,(SELECT CON_PK FROM ADM_CONST_MST WHERE CON_GROUP = 59 AND CON_CODE = [X14])&#xA;			,NULL&#xA;			,NULL&#xA;			,[UPDATEDNAME]&#xA;			,1			--ACTIVE&#xA;			,1			--MOD BY&#xA;			,GETDATE()	&#xA;		FROM 	&#xA;		(&#xA;		SELECT *&#xA;				,ROW_NUMBER()OVER(PARTITION BY [UPDATEDCODE] ORDER BY [UPDATEDNAME])  as row&#xA;		FROM [Z_BWH_PRODUCTS] &#xA;		)tab&#xA;			INNER JOIN INV_ITEM_MST	ON	ITM_CODE = [UPDATEDCODE]&#xA;		where row=1	&#xA;			AND ITM_PK	NOT IN (SELECT ISD_ITEM FROM INV_ITEM_SPEC_DTL)&#xA;			&#xA;	---insert into product grade map 	&#xA;	INSERT INTO PRD_PRODUCT_GRADE_MAP&#xA;		(&#xA;			PGM_PRODUCT&#xA;			,PGM_CONST&#xA;			,PGM_ITEM&#xA;		)&#xA;	SELECT ITM_PK&#xA;			,1					--GRADE&#xA;			,NULL&#xA;	FROM	[INV_ITEM_MST]										&#xA;	WHERE	[ITM_CATEGORY] = 2	&#xA;&#xA;	--ROLLBACK TRAN&#xA;	COMMIT TRAN&#xA;	&#xA;END TRY&#xA;BEGIN CATCH&#xA;	ROLLBACK TRAN&#xA;	PRINT	ERROR_MESSAGE()	&#xA;END CATCH&#xA;" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
