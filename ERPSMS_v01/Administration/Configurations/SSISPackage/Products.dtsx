<DTS:Property DTS:Name="Description">Execute SQL Task</DTS:Property>
<DTS:Property DTS:Name="CreationName">Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask, Microsoft.SqlServer.SQLTask, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91</DTS:Property>
<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{4DDFBD61-6F2A-412F-89E4-12F344D6F437}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="BEGIN TRY&#xA;	BEGIN TRAN&#xA;	--UPDATE Z_BWH_PRODUCTS&#xA;	--SET X16 = SUBSTRING(UPDATEDCODE,26,3)&#xA;&#xA;&#xA;	DECLARE @TMP_GRP TABLE &#xA;		(&#xA;			CODE			NVARCHAR(100)&#xA;			,NAME			NVARCHAR(500)&#xA;		)&#xA;		&#xA;	INSERT INTO @TMP_GRP&#xA;		(&#xA;			 NAME&#xA;			,CODE&#xA;		)&#xA;&#xA;	SELECT DISTINCT&#xA;	REPLACE(REPLACE(ISNULL(t.CON_NAME,'') +';'+&#xA;			ISNULL(t1.CON_NAME,'')+';'+&#xA;			ISNULL(t2.CON_NAME,'')+';'+&#xA;			ISNULL(t3.CON_NAME,'')+';'+&#xA;			ISNULL(t4.CON_NAME,'')+';'+&#xA;			ISNULL(t5.CON_NAME,'')+';'+&#xA;			--ISNULL(t6.CON_NAME,'')+';'+&#xA;			ISNULL(t7.CON_NAME,'')+';'+&#xA;			ISNULL(t8.CON_NAME,'')+';'+&#xA;			ISNULL(t9.CON_NAME,'')+';'+&#xA;			ISNULL(t10.CON_NAME,'')+';'+&#xA;			ISNULL(t11.CON_NAME,'')+';'+&#xA;			ISNULL(t12.CON_NAME,'')+';'+&#xA;			ISNULL(t13.CON_NAME,'')+';'+&#xA;			ISNULL(t14.CON_NAME,'')+';'+&#xA;			ISNULL(t15.CON_NAME,''),'NA;',' '),';',' ') as name &#xA;			,s.X1+''+		&#xA;			s.X2+''+&#xA;			s.X3+''+		&#xA;			s.X4+''+	&#xA;			s.X5+''+		&#xA;			s.X6+''+		&#xA;			--s.code7+''+		&#xA;			s.X8+''+		&#xA;			s.X9+''+	&#xA;			s.X10+''+&#xA;			s.X11+''+	&#xA;			s.X12+''+	&#xA;			s.X13+''+	&#xA;			s.X14+''+	&#xA;			s.X15+''+		&#xA;			s.X16		as code &#xA;	FROM Z_BWH_PRODUCTS s&#xA;		LEFT JOIN ADM_CONST_MST t&#xA;			ON s.X1 = t.CON_CODE&#xA;				AND t.CON_GROUP = 42&#xA;		LEFT JOIN ADM_CONST_MST t1&#xA;			ON s.X2 = t1.CON_CODE&#xA;				AND t1.CON_GROUP = 54&#xA;		LEFT JOIN ADM_CONST_MST t2&#xA;			ON s.X3 = t2.CON_CODE&#xA;				AND t2.CON_GROUP = 44&#xA;		LEFT JOIN ADM_CONST_MST t3&#xA;			ON s.X4 = t3.CON_CODE&#xA;				AND t3.CON_GROUP = 45 &#xA;		LEFT JOIN ADM_CONST_MST t4&#xA;			ON s.X5 = t4.CON_CODE&#xA;				AND t4.CON_GROUP = 49&#xA;		LEFT JOIN ADM_CONST_MST t5&#xA;			ON s.X6 = t5.CON_CODE&#xA;				AND t5.CON_GROUP = 46 &#xA;		LEFT JOIN ADM_CONST_MST t6&#xA;			ON s.X7 = t6.CON_CODE&#xA;				AND t6.CON_GROUP = 48&#xA;		LEFT JOIN ADM_CONST_MST t7&#xA;			ON s.X8 = t7.CON_CODE&#xA;				AND t7.CON_GROUP = 51&#xA;		LEFT JOIN ADM_CONST_MST t8&#xA;			ON s.X9 = t8.CON_CODE&#xA;				AND t8.CON_GROUP = 52 &#xA;		LEFT JOIN ADM_CONST_MST t9&#xA;			ON s.X10 = t9.CON_CODE&#xA;				AND t9.CON_GROUP = 55 &#xA;		LEFT JOIN ADM_CONST_MST t10&#xA;			ON s.X11 = t10.CON_CODE&#xA;				AND t10.CON_GROUP = 56&#xA;		LEFT JOIN ADM_CONST_MST t11&#xA;			ON s.X12 = t11.CON_CODE&#xA;				AND t11.CON_GROUP = 57 &#xA;		LEFT JOIN ADM_CONST_MST t12&#xA;			ON s.X13 = t12.CON_CODE&#xA;				AND t12.CON_GROUP = 58&#xA;		LEFT JOIN ADM_CONST_MST t13&#xA;			ON s.X14 = t13.CON_CODE&#xA;				AND t13.CON_GROUP = 59&#xA;		LEFT JOIN ADM_CONST_MST t14&#xA;			ON s.X15 = t14.CON_CODE&#xA;				AND t14.CON_GROUP = 47&#xA;		LEFT JOIN ADM_CONST_MST t15&#xA;			ON s.X16 = t15.CON_CODE&#xA;				AND t15.CON_GROUP = 43 &#xA;				&#xA;	DELETE FROM @TMP_GRP WHERE code is null OR NAME is null&#xA;&#xA;	INSERT INTO dbo.INV_ITEM_GROUP_MST&#xA;	SELECT	 ROW_NUMBER()OVER(ORDER BY CODE) + (SELECT ISNULL(MAX(IGM_PK),0) FROM INV_ITEM_GROUP_MST )&#xA;			,CODE&#xA;			,NAME &#xA;			,NAME &#xA;			,1&#xA;			,1&#xA;			,1&#xA;			,GETDATE()&#xA;			,1&#xA;			,GETDATE()&#xA;			,1&#xA;	FROM @TMP_GRP&#xA;	WHERE code is NOT null AND NAME is NOT null&#xA;		AND CODE NOT IN (SELECT IGM_CODE FROM INV_ITEM_GROUP_MST)&#xA;&#xA;&#xA;	UPDATE iim&#xA;				SET ITM_GROUP = IGM_PK&#xA;				FROM INV_ITEM_MST iim&#xA;					INNER JOIN INV_ITEM_GROUP_MST&#xA;						ON IGM_CODE = STUFF(ITM_CODE,12,3,'')&#xA;							--AND IGM_NAME = REPLACE(ITM_NAME,SUBSTRING(ITM_CODE,12,3),'')&#xA;				WHERE ITM_CATEGORY = 2&#xA;				&#xA;		--SELECT * FROM INV_ITEM_MST WHERE ITM_CODE = '' &#xA;		--SELECT * FROM INV_ITEM_GROUP_MST&#xA;		--SELECT * FROM INV_ITEM_MST WHERE ITM_GROUP IS NULL AND ITM_CATEGORY = 2&#xA;	--ROLLBACK&#xA;				DELETE &#xA;				FROM PRD_PRODUCT_GRADE_MAP &#xA;				WHERE  PGM_PRODUCT IN (SELECT ITM_PK &#xA;										FROM INV_ITEM_MST &#xA;										WHERE ITM_CODE = '')&#xA;				&#xA;				&#xA;				DELETE &#xA;				FROM INV_ITEM_SPEC_DTL&#xA;				WHERE  ISD_ITEM IN (SELECT ITM_PK &#xA;										FROM INV_ITEM_MST &#xA;										WHERE ITM_CODE = '')&#xA;										&#xA;			--	DELETE FROM INV_ITEM_MST WHERE ITM_CODE = '' comment to be removed&#xA;	--ROLLBACK TRAN&#xA;		COMMIT TRAN&#xA;&#xA;	SELECT	'Completed Successfully..!!' AS [Message]&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;	ROLLBACK TRAN&#xA;	PRINT	ERROR_MESSAGE()	&#xA;END CATCH" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
