<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{4DDFBD61-6F2A-412F-89E4-12F344D6F437}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="SELECT COUNT(1) as ROW&#xA;FROM(&#xA;SELECT s.X1,ROW_NO,CUSCODE,UPDATEDCODE,1 as attrNUM&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t&#xA;		ON s.X1 = t.CON_CODE&#xA;			AND t.CON_GROUP = 42&#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X2,ROW_NO,CUSCODE,UPDATEDCODE,2&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t1&#xA;		ON s.X2 = t1.CON_CODE&#xA;			AND t1.CON_GROUP = 54&#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X3,ROW_NO,CUSCODE,UPDATEDCODE,3&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t2&#xA;		ON s.X3 = t2.CON_CODE&#xA;			AND t2.CON_GROUP = 44&#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X4,ROW_NO,CUSCODE,UPDATEDCODE,4&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t3&#xA;		ON s.X4 = t3.CON_CODE&#xA;			AND t3.CON_GROUP = 45&#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X5,ROW_NO,CUSCODE,UPDATEDCODE,5&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t4&#xA;		ON s.X5 = t4.CON_CODE&#xA;			AND t4.CON_GROUP = 49&#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X6,ROW_NO,CUSCODE,UPDATEDCODE,6&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t5&#xA;		ON s.X6 = t5.CON_CODE&#xA;			AND t5.CON_GROUP = 46 &#xA;WHERE CON_PK IS NULL &#xA;UNION ALL&#xA;SELECT s.X7,ROW_NO,CUSCODE,UPDATEDCODE,7&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t6&#xA;		ON s.X7 = t6.CON_CODE&#xA;			AND t6.CON_GROUP = 48&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;SELECT s.X8,ROW_NO,CUSCODE,UPDATEDCODE,8&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t7&#xA;		ON s.X8 = t7.CON_CODE&#xA;			AND t7.CON_GROUP = 51&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA; SELECT s.X9,ROW_NO,CUSCODE,UPDATEDCODE,9&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t8&#xA;		ON s.X9 = t8.CON_CODE&#xA;			AND t8.CON_GROUP = 52 &#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA; SELECT s.X10,ROW_NO,CUSCODE,UPDATEDCODE,10&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t9&#xA;		ON s.X10 = t9.CON_CODE&#xA;			AND t9.CON_GROUP = 55 &#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA; SELECT s.X11,ROW_NO,CUSCODE,UPDATEDCODE,11&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t10&#xA;		ON s.X11 = t10.CON_CODE&#xA;			AND t10.CON_GROUP = 56&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;	 SELECT s.X12,ROW_NO,CUSCODE,UPDATEDCODE,12&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t11&#xA;		ON s.X12 = t11.CON_CODE&#xA;			AND t11.CON_GROUP = 57 &#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;SELECT s.X13,ROW_NO,CUSCODE,UPDATEDCODE,13&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t12&#xA;		ON s.X13 = t12.CON_CODE&#xA;			AND t12.CON_GROUP = 58&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;SELECT s.X14,ROW_NO,CUSCODE,UPDATEDCODE,14&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t13&#xA;		ON s.X14 = t13.CON_CODE&#xA;			AND t13.CON_GROUP = 59&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;	SELECT s.X15,ROW_NO,CUSCODE,UPDATEDCODE,15&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t14&#xA;		ON s.X15 = t14.CON_CODE&#xA;			AND t14.CON_GROUP = 47&#xA;WHERE CON_PK IS NULL&#xA;UNION ALL&#xA;SELECT s.X16,ROW_NO,CUSCODE,UPDATEDCODE,16&#xA;FROM Z_BWH_PRODUCTS s&#xA;	LEFT JOIN ADM_CONST_MST t15&#xA;		ON s.X16 = t15.CON_CODE&#xA;			AND t15.CON_GROUP = 43 &#xA;	WHERE CON_PK IS NULL&#xA;	) t" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"><SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::V_invalid_code"/></SQLTask:SqlTaskData></DTS:ObjectData></DTS:Executable>
