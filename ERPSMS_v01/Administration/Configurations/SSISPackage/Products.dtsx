<DTS:Property DTS:Name="DisableEventHandlers">0</DTS:Property><DTS:ObjectData><SQLTask:SqlTaskData SQLTask:Connection="{4DDFBD61-6F2A-412F-89E4-12F344D6F437}" SQLTask:TimeOut="0" SQLTask:IsStoredProc="False" SQLTask:BypassPrepare="True" SQLTask:SqlStmtSourceType="DirectInput" SQLTask:SqlStatementSource="BEGIN TRAN&#xA;--SELECT * FROM Z_BWH_PRODUCTS ORDER BY ROW_NO&#xA;--DELETE FROM Z_BWH_PRODUCTS&#xA;IF EXISTS (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Z_BWH_PRODUCTS')&#xA;	BEGIN &#xA;		DROP TABLE Z_BWH_PRODUCTS&#xA;	END&#xA;&#xA;		CREATE TABLE Z_BWH_PRODUCTS&#xA;		(&#xA;			ROW_NO			INT&#xA;			,CUSCODE		NVARCHAR(200)&#xA;			,ITMNAME		NVARCHAR(500)&#xA;			,OLDCODE		NVARCHAR(200)&#xA;			,X1				NVARCHAR(200)&#xA;			,X2				NVARCHAR(200)&#xA;			,X3				NVARCHAR(200)&#xA;			,X4				NVARCHAR(200)&#xA;			,X5				NVARCHAR(200)&#xA;			,X6				NVARCHAR(200)&#xA;			,X7				NVARCHAR(200)&#xA;			,X8				NVARCHAR(200)&#xA;			,X9				NVARCHAR(200)&#xA;			,X10			NVARCHAR(200)&#xA;			,X11			NVARCHAR(200)&#xA;			,X12			NVARCHAR(200)&#xA;			,X13			NVARCHAR(200)&#xA;			,X14			NVARCHAR(200)&#xA;			,X15			NVARCHAR(200)&#xA;			,X16			NVARCHAR(200)&#xA;			,UPDATEDCODE	NVARCHAR(200)&#xA;			,UPDATEDNAME	NVARCHAR(500)&#xA;			,NEWCODE		NVARCHAR(200)&#xA;			,UNIT			NVARCHAR(200)&#xA;			,AVG_WT			FLOAT&#xA;			,MIN_WT			FLOAT&#xA;			,MAX_WT			FLOAT&#xA;			,CUFF_THICK		FLOAT	&#xA;			,PALM_THICK		FLOAT	&#xA;			,FINGER_THICK	FLOAT	&#xA;			,PROD_SPEC		NVARCHAR(200)&#xA;			,[510K]			NVARCHAR(200)&#xA;			,MDL			NVARCHAR(200)&#xA;		)&#xA;		&#xA;		TRUNCATE TABLE Z_BWH_PRODUCTS&#xA;&#xA;&#xA;&#xA;COMMIT" SQLTask:CodePage="1252" SQLTask:ResultType="ResultSetType_None" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"/></DTS:ObjectData></DTS:Executable>
