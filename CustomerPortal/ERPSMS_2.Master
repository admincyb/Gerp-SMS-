    TagPrefix="uc2" %>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <link rel="shortcut icon" type="image/x-icon" href="images/favicon.ico" />
    <title>gERP – STORE MANAGEMENT</title>
    <asp:Literal ID="scriptSrc" Text="" runat="server"></asp:Literal>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <%--   <script src="../Scripts/jquery/moment.min.js" type="text/javascript"></script>--%>
    <style type="text/css">
        .fixed_overlay
        {
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
        }
        .fixed_overlay_img
        {
            left: 46% !important;
            top: 45% !important;
        }
        .fixed_overlay_img_pos
        {
            position: fixed !important;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <script type="text/javascript" language="javascript">
        //var excludeUrl = "AutoComplete.ashx?SearchType=MESSAGECOUNT".toLocaleLowerCase();
        var excludeUrl = "&AUTOSEARCH=1";
        var excludeUiAutoComplete = "Handlers/UIAutoComplete.ashx";
        var excludeAutoComplete = "Handlers/AutoComplete.ashx";
        var excludeMenuAutoComplete = "GetAutoCompleteMenu";
        $.xhrPool = [];
        //var pendingProgress = false;

        //        $(document).ajaxStart(function (event, jqxhr, settings) {
        //            if ($.xhrPool.length > 0) {                
        //                $('#updateProgress').show();
        //            }
        //        });

        $(document).ajaxStop(function (event, jqxhr, settings) {
            //Preserver the loading symbol before getting response from server.
            //This case is occured when wait long time for server response 
            //You can set hdfWaitForServerResponse = 1 in content page, if you need to preserver the loading symbol untill get response from server
            if ($("[id$=hdfWaitForServerResponse]").val() == "0")
                $('#updateProgress').hide();
        });       

        $(document).ajaxSend(function (event, jqxhr, settings) {
            var isExcludeUrl = settings.url.indexOf(excludeUrl);
            var isExcludeUiAutoComplete = settings.url.indexOf(excludeUiAutoComplete);
            var isExcludeAutoComplete = settings.url.indexOf(excludeAutoComplete);
            var isExcludeMenuAutoComplete = settings.url.indexOf(excludeMenuAutoComplete);

            if (isExcludeUrl === -1 && isExcludeUiAutoComplete === -1 && isExcludeAutoComplete === -1 && isExcludeMenuAutoComplete == -1) {
                if ($.xhrPool.length === 0) {
                    $('#updateProgress').show();
                }
                $.xhrPool.push(jqxhr);
                //alert("start: " + settings.url);
            }
        });

        function ajaxProgressTracking() {
            $.ajaxSetup({
                cache: false,
                global: true,
                beforeSend: function (jqXHR, settings) {
                    var isExcludeUrl = settings.url.indexOf(excludeUrl);
                    var isexcludeUiAutoComplete = settings.url.indexOf(excludeUiAutoComplete);
                    var isexcludeAutoComplete = settings.url.indexOf(excludeAutoComplete);
                    if (isExcludeUrl === -1 && isexcludeUiAutoComplete === -1 && isexcludeAutoComplete === -1) {
                        alert('inside');
                        if ($.xhrPool.length === 0) {
                            $('#updateProgress').show();
                        }
                        $.xhrPool.push(jqXHR);
                        alert("start: " + settings.url);
                    }
                },
                complete: function (jqXHR) {
                    var isExcludeUrl = this.url.indexOf(excludeUrl);
                    var isexcludeUiAutoComplete = this.url.indexOf(excludeUiAutoComplete);
                    var isexcludeAutoComplete = this.url.indexOf(excludeAutoComplete);
                    if (isExcludeUrl === -1 && isexcludeUiAutoComplete === -1 && isexcludeAutoComplete === -1) {
                        alert("end: " + this.url);
                        if ($.xhrPool.length > -1) {
                            $.xhrPool.pop(jqXHR);
                        }
                        if ($.xhrPool.length === 0 && $("[id$=hdfWaitForServerResponse]").val() == "0") {
                            $('#updateProgress').hide();
                        }
                    }
                },
                error: function (jqXHR, exception) {
                    $.xhrPool.pop(jqXHR);
                    alert("error:" + this.url);
                    if ($.xhrPool.length === 0 && $("[id$=hdfWaitForServerResponse]").val() == "0") {
                        $('#updateProgress').hide();
                    }
                }
            });
        }

        $(document).ready(function () {
//            //if (typeof (Storage) !== 'undefined') { sessionStorage.setItem('uniqueIdSessionStorage', 'xyz') }
//            if (sessionStorage.getItem('uniqueIdSessionStorage') !=  $("[id$='hdfAuthValue']").val()) {
//                sessionStorage.setItem('uniqueIdSessionStorage', null);
//               
//                window.location = "../InvalidTab.aspx";
//                //$("[id$=imbLogout]").click();
//            }

            //ajaxProgressTracking();            
            var pageURL = window.document.URL;
            var virtualPath = $("[id$='hdfAbsolutePath']").val();
            var urlauto = pageURL.replace(location.pathname, virtualPath == "" ? "/Handlers/AutoComplete.ashx" : "/" + virtualPath + "Handlers/AutoComplete.ashx");

            $("[id$=divNewMessage]").hide();
            getMessageCount();
            var myVar = setInterval(function () { getMessageCount() }, 60000);
            function getMessageCount() {
                $.get(urlauto, 'SearchType=MESSAGECOUNT&AUTOSEARCH=1',
                function (data) {
                    var cnt = parseInt(data);
                    if (isNaN(cnt) == false) {
                        if (cnt > 0) {
                            if ($("[id$=lblMessageCount]").html() != data && $("[id$='hdfIsAlertSound']").val() == "1")
                                playAudio('notify');
                            $("[id$=divNewMessage]").show();
                            $("[id$=lblMessageCount]").html(data);
                        }
                        else {
                            $("[id$=divNewMessage]").hide();
                        }
                    }
                    else {
                        $("[id$=divNewMessage]").hide();
                    }
                });
            }
        });

        function hideProgress() {
            $('#updateProgress').hide();
        }

        ///Show Hide compnay based on ConfigResource
        function ShowCompany() {
            if ($("[id$='hdfIsCompanyShow']").val() == "0") {
                $("[id$=divSBUCompany]").hide();
            }
            ShowPlantCompany();
        }

        ///Show Hide Plant or Company 
        function ShowPlantCompany() {
            if ($("[id$='hdfIsCompanyPlantShow']").val() == "0") {
                $("[id$=divPlantCompany]").hide();
            }
        }
    </script>
</head>
<body>
