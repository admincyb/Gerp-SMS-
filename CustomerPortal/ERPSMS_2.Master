    <script type="text/javascript" language="javascript">
        //For Fixed Overlay
        function SetWrapper() {
            $("#wrapper").css({ "height": $(window).height() + "px", "width": $(window).width() + "px" });
        }
        $(document).ready(function () {

            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(EndRequestHandler);
            Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(BeginRequestHandler);
            //Set Textbox Selected on Focus
            $('input:text').focus(function () {
                $(this).select();
            });
            // For Setting Overlay Style
            $("#wrapper").css({ "height": $(window).height() + "px", "width": $(window).width() + "px" });
            if (navigator.appName == "Microsoft Internet Explorer") {
                $(".fixed_overlay_img").css({ "position": "absolute!important" });
            }
            else {
                $(".fixed_overlay_img").addClass("fixed_overlay_img_pos");
            }
            $("#divmodel").css({ "height": $('html').height() });
        });
        function encodeInput() {
            $("input[type='text'],textarea").each(function () {
                var oldValue = $(this).val();
                $("#popupHolder").html(oldValue);
                var newValue = $("#popupHolder").html();
                newValue = newValue.replace("<", "&lt;");
                newValue = newValue.replace(">", "&gt;");
                $(this).val(newValue);
                $("#popupHolder").html("");
            });
        }
        function BeginRequestHandler(sender, args) {

            $("#updateProgress").show();
            if (typeof BeginRequest == "function") {
                //                BeginRequest();
                SetWrapper();
            }
        }

        function ClosePopup() {
            $('html').css('overflow', 'auto');
            $('body').css('overflow', 'visible');
            if ($('#divmodel').length > 0) {
                $('#divmodel').hide();
            }
        }
        //        // Validate the input text controls to prevent XSS
        //        function EndRequestHandler(sender, args) {
        //            if (typeof EndRequest == "function") {
        //                EndRequest();
        //            }

        //            //To add tooltip to dropdown
        //            $("#updateProgress").hide();
        //            if ($.browser.msie) {
        //                $("select").each(function () {
        //                    var drp = $(this);
        //                    $(drp).attr("id");
        //                    $(drp).find("option").each(function () {
        //                        $(this).attr("title", $(this).text());
        //                    });
        //                });
        //            }

        //            //To add tooltip to autocomplete
        //            $("input:text.ui-autocomplete-input").each(function () {
        //                $(this).attr("title", $(this).val());
        //            });
        function EndRequestHandler(sender, args) {
            $('input:text').focus(function () {
                $(this).select();
            });
            if (typeof EndRequest == "function") {
                EndRequest();
            }

            //            if (args.get_error() != undefined && args.get_error().httpStatusCode == '500') {
            //                var errorMessage;
            //                var errorResponse = args.get_response();
            //                args.set_errorHandled(true);

            //                if (errorResponse._xmlHttpRequest) {
            //                    errorMessage = errorResponse._xmlHttpRequest.responseText;
            //                    //errorMessage = $(errorMessage).find("title").text();
            //                    //XSS Attack..
            //                    if (errorMessage.indexOf('A potentially dangerous Request.Form value') >= 0) {
            //                        ShowErrorMessage("Potentially Dangerous input found! Please refine your input");
            //                    }
            //                }
            //            }

            //To add tooltip to dropdown
            $("#updateProgress").hide();
            if ($.browser.msie) {
                $("select").each(function () {
                    var drp = $(this);
                    $(drp).attr("id");
                    $(drp).find("option").each(function () {
                        $(this).attr("title", $(this).text());
                    });
                });
            }

            //To add tooltip to autocomplete
            $("input:text.ui-autocomplete-input").each(function () {
                $(this).attr("title", $(this).val());
            });

            //To remove unnecessary space between controls
            $(document).ready(function () {
                $('.divcolmiddle-S,.input-inlinediv,.small-input-width,.div2col-S').contents().filter(function () {
                    return this.nodeType === 3;
                }).remove();
            });

            $("input:text,input:file,select").live("keydown", function (event) {
                // track enter key
                var keycode = (event.keyCode ? event.keyCode : (event.which ? event.which : event.charCode));
                if (keycode == 13) { // keycode for enter key
                    // force prevent Default
                    event.preventDefault();
                }
            });        // end of function
            if (typeof EndRequestHandlerPage == 'function') {
                $("#wrapper").css({ "height": $(document).height() + "px", "width": $(document).width() + "px" });
                //$("#divmodel").css({ "height": $('html').height() });
                EndRequestHandlerPage();
            }
            if ($('#popupHolder div.ui-dialog').is(':visible')) {
                var heightDiff = ($('html').height() - $('#popupHolder div.ui-dialog').height()) / 2;
                $('#divmodel').height(heightDiff > 0 ? $('html').height() : $('#popupHolder div.ui-dialog').height());
                $('html').scrollTop(0);
                $('html,body').animate({ scrollTop: 0 });
                $('#popupHolder div.ui-dialog').css('top', heightDiff > 0 ? heightDiff : 0);
            }
        }
        //To remove unnecessary space between controls
        $(document).ready(function () {
            $('.divcolmiddle-S,.input-inlinediv,.small-input-width,.div2col-S').contents().filter(function () {
                return this.nodeType === 3;
            }).remove();
        });
        $(document).ready(function () {
            if ($.browser.msie) {
                $("select").each(function () {
                    var drp = $(this);
                    $(drp).attr("id");
                    $(drp).find("option").each(function () {
                        $(this).attr("title", $(this).text());
                    });
                });
            }
            $("input:text.ui-autocomplete-input").each(function () {
                $(this).attr("title", $(this).val());
            });
            $("input:text,input:file,select").live("keydown", function (event) {
                // track enter key
                var keycode = (event.keyCode ? event.keyCode : (event.which ? event.which : event.charCode));
                if (keycode == 13) { // keycode for enter key
                    // force prevent Default
                    event.preventDefault();
                }
            });    // end of function 
        });


        function ShowDeleteConfirm(btn, message) {
            var msgTitle;
            var msg;
            msgTitle = '<%= Resources.ErpRes.Title_Information %>';
            msg = message ? message : '<%= Resources.ErpRes.MsgDeleteConfirm %>';
            $("#divConfirmation").html(msg).dialog({
                modal: true,
                height: 150,
                width: 350,
                title: msgTitle,
                resizable: false,
                buttons: {
                    OK: function (e) {
                        $(this).dialog("close");
                        __doPostBack(btn.name, '');
                    },
                    Cancel: function (e) {
                        $(this).dialog("close");
                        if (typeof AfterDeleteConfirmationCancel == "function") {
                            AfterDeleteConfirmationCancel(btn.id);
                        }
                        return false;
                    }
                }
            });
            return false;
        }

        function compareDate(dateStrig1, dateString2) {
            var date1 = new moment(dateStrig1, "DD-MMM-YYYY");
            var date2 = new moment(dateString2, "DD-MMM-YYYY");
            if (isNaN(date2)) {
                return false;
            }
            return date1 > date2;
        }

    </script>
</body>
</html>
