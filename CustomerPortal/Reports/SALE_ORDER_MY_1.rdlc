&amp; IIF(len(Fields!CIM_BRAND_TEXT.Value) &gt;5,IIF((Left(Right(Fields!CIM_BRAND_TEXT.Value, 5),1) = "(")and (Right(Fields!CIM_BRAND_TEXT.Value, 1)=")"),Code.HTMLDecode(Left(Fields!CIM_BRAND_TEXT.Value,Len(Fields!CIM_BRAND_TEXT.Value)- CInt(IIF(Len(Fields!CIM_BRAND_TEXT.Value)&gt;5,5,0)) )),Code.HTMLDecode(Fields!CIM_BRAND_TEXT.Value)),Code.HTMLDecode(Fields!CIM_BRAND_TEXT.Value))</Value>
                              <Style>
