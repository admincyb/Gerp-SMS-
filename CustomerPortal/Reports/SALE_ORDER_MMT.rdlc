              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=Code.HTMLDecode(First(Fields!CMP_NAME.Value, "CompanyDtls")) &amp; VBCRLF &amp; 
Code.HTMLDecode(First(Fields!CMP_ADDR1.Value, "CompanyDtls")) &amp; VBCRLF &amp; 
Code.HTMLDecode(First(Fields!CMP_ADDR2.Value, "CompanyDtls")) &amp; VBCRLF &amp; 
iif(Len(First(Fields!CMP_PHONE.Value, "CompanyDtls"))&gt;0,"Tel : " &amp; First(Fields!CMP_PHONE.Value, "CompanyDtls"),"") &amp; 
iif(Len(First(Fields!CMP_FAX.Value, "CompanyDtls"))&gt;0
	,iif(Len(First(Fields!CMP_PHONE.Value, "CompanyDtls"))&gt;0
		, "  Fax : " &amp; First(Fields!CMP_FAX.Value, "CompanyDtls")
		, "Fax : " &amp; First(Fields!CMP_FAX.Value, "CompanyDtls"))
	,"") &amp; VBCRLF &amp;
iif(Len(First(Fields!CMP_EMAIL.Value, "CompanyDtls"))&gt;0,"Email : " &amp; First(Fields!CMP_EMAIL.Value, "CompanyDtls"),"") &amp; 
iif(Len(First(Fields!CMP_WEBSITE.Value, "CompanyDtls"))&gt;0
	,iif(Len(First(Fields!CMP_EMAIL.Value, "CompanyDtls"))&gt;0
		,"  Website : " &amp; First(Fields!CMP_WEBSITE.Value, "CompanyDtls")
		,"Website : " &amp; First(Fields!CMP_WEBSITE.Value, "CompanyDtls"))
	,"")</Value>
                      <Style>
                        <FontFamily>Verdana</FontFamily>
                        <FontSize>8pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
